@{
    ViewData["Title"] = "Главная страница колледжа";
}

<div class="row mb-4">
    <div class="col-12">
        <div class="p-5 text-white bg-primary bg-gradient rounded-3 shadow-sm d-flex flex-column justify-content-between">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                <div>
                    <span class="badge bg-light text-dark mb-2 px-3 py-2 fw-semibold">
                        <i class="bi bi-calendar-event me-1"></i> Учебный год: @ViewBag.AcademicYear
                    </span>
                    <h1 class="display-5 fw-bold mb-2">@ViewBag.CollegeName</h1>
                    <p class="lead mb-3">Информационная система управления колледжем с демонстрацией модификаторов доступа C#</p>
                    <p class="mb-0 text-white-50 small">
                        <i class="bi bi-geo-alt-fill me-1"></i> @ViewBag.Address &nbsp;|&nbsp; 
                        <i class="bi bi-telephone-fill me-1"></i> @ViewBag.PhoneNumber
                    </p>
                </div>
                <div class="text-end">
                    <a asp-action="AccessModifiersGuide" class="btn btn-warning btn-lg fw-bold shadow-sm">
                        <i class="bi bi-shield-check me-1"></i> Справка по 30 заданиям
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Статистика колледжа -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card shadow-sm h-100 border-start border-primary border-4 card-hover">
            <div class="card-body d-flex align-items-center justify-content-between">
                <div>
                    <h6 class="text-muted text-uppercase mb-1 small fw-bold">Студентов</h6>
                    <h2 class="mb-0 fw-bold text-primary">@ViewBag.StudentsCount</h2>
                    <span class="text-muted small">Обучаются на курсах</span>
                </div>
                <div class="bg-primary-subtle p-3 rounded-circle text-primary">
                    <i class="bi bi-people-fill fs-3"></i>
                </div>
            </div>
            <div class="card-footer bg-transparent border-0 pt-0">
                <a asp-controller="Student" asp-action="Index" class="btn btn-sm btn-outline-primary w-100">Список студентов &rarr;</a>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm h-100 border-start border-success border-4 card-hover">
            <div class="card-body d-flex align-items-center justify-content-between">
                <div>
                    <h6 class="text-muted text-uppercase mb-1 small fw-bold">Преподавателей</h6>
                    <h2 class="mb-0 fw-bold text-success">@ViewBag.TeachersCount</h2>
                    <span class="text-muted small">Штатные сотрудники</span>
                </div>
                <div class="bg-success-subtle p-3 rounded-circle text-success">
                    <i class="bi bi-person-badge-fill fs-3"></i>
                </div>
            </div>
            <div class="card-footer bg-transparent border-0 pt-0">
                <a asp-controller="Teacher" asp-action="Index" class="btn btn-sm btn-outline-success w-100">Преподаватели &rarr;</a>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm h-100 border-start border-info border-4 card-hover">
            <div class="card-body d-flex align-items-center justify-content-between">
                <div>
                    <h6 class="text-muted text-uppercase mb-1 small fw-bold">Учебных групп</h6>
                    <h2 class="mb-0 fw-bold text-info">@ViewBag.GroupsCount</h2>
                    <span class="text-muted small">1 - 4 курсы</span>
                </div>
                <div class="bg-info-subtle p-3 rounded-circle text-info">
                    <i class="bi bi-collection-fill fs-3"></i>
                </div>
            </div>
            <div class="card-footer bg-transparent border-0 pt-0">
                <a asp-controller="Group" asp-action="Index" class="btn btn-sm btn-outline-info w-100">Группы &rarr;</a>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm h-100 border-start border-warning border-4 card-hover">
            <div class="card-body d-flex align-items-center justify-content-between">
                <div>
                    <h6 class="text-muted text-uppercase mb-1 small fw-bold">Выставлено оценок</h6>
                    <h2 class="mb-0 fw-bold text-warning">@ViewBag.GradesCount</h2>
                    <span class="text-muted small">Шкала 2 - 5 баллов</span>
                </div>
                <div class="bg-warning-subtle p-3 rounded-circle text-warning">
                    <i class="bi bi-journal-check fs-3"></i>
                </div>
            </div>
            <div class="card-footer bg-transparent border-0 pt-0">
                <a asp-controller="Grade" asp-action="Index" class="btn btn-sm btn-outline-warning w-100">Журнал оценок &rarr;</a>
            </div>
        </div>
    </div>
</div>

<!-- Модули системы -->
<div class="row g-4 mb-4">
    <div class="col-lg-8">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold"><i class="bi bi-grid-fill text-primary me-2"></i> Разделы веб-приложения</h5>
                <span class="badge bg-secondary">ASP.NET Core 8 MVC</span>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="p-3 border rounded-3 bg-light h-100 d-flex flex-column justify-content-between">
                            <div>
                                <h6 class="fw-bold text-primary"><i class="bi bi-person-lines-fill me-1"></i> Студенты и инкапсуляция</h6>
                                <p class="small text-muted mb-2">Управление персональными данными студентов. Защищенный возраст от 15 до 70 лет, неизменяемый StudentId, закрытые методы валидации.</p>
                                <span class="modifier-badge mod-private me-1">private</span>
                                <span class="modifier-badge mod-public me-1">public</span>
                                <span class="modifier-badge mod-protected">protected</span>
                            </div>
                            <div class="mt-3">
                                <a asp-controller="Student" asp-action="Index" class="btn btn-sm btn-primary">Перейти в Студенты</a>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="p-3 border rounded-3 bg-light h-100 d-flex flex-column justify-content-between">
                            <div>
                                <h6 class="fw-bold text-success"><i class="bi bi-mortarboard me-1"></i> Преподаватели и стаж</h6>
                                <p class="small text-muted mb-2">Управление преподавательским составом. Ограничение изменения стажа через специальный метод UpdateExperience() и привязка к дисциплинам.</p>
                                <span class="modifier-badge mod-private me-1">private</span>
                                <span class="modifier-badge mod-public">public</span>
                            </div>
                            <div class="mt-3">
                                <a asp-controller="Teacher" asp-action="Index" class="btn btn-sm btn-success text-white">Перейти в Преподаватели</a>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="p-3 border rounded-3 bg-light h-100 d-flex flex-column justify-content-between">
                            <div>
                                <h6 class="fw-bold text-info"><i class="bi bi-collection me-1"></i> Группы и студенты</h6>
                                <p class="small text-muted mb-2">Закрытый список студентов внутри группы. Добавление без дублирования (AddStudent) и безопасное удаление (RemoveStudent).</p>
                                <span class="modifier-badge mod-private me-1">private list</span>
                                <span class="modifier-badge mod-public">public Add/Remove</span>
                            </div>
                            <div class="mt-3">
                                <a asp-controller="Group" asp-action="Index" class="btn btn-sm btn-info text-white">Перейти в Группы</a>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="p-3 border rounded-3 bg-light h-100 d-flex flex-column justify-content-between">
                            <div>
                                <h6 class="fw-bold text-warning"><i class="bi bi-journal-text me-1"></i> Журнал и посещаемость</h6>
                                <p class="small text-muted mb-2">Электронный журнал оценок (валидация 2-5) и трекинг посещаемости занятий со статистикой присутствия.</p>
                                <span class="modifier-badge mod-private me-1">private storage</span>
                                <span class="modifier-badge mod-public">public statistics</span>
                            </div>
                            <div class="mt-3">
                                <a asp-controller="Grade" asp-action="Index" class="btn btn-sm btn-warning text-dark me-2">Оценки</a>
                                <a asp-controller="Attendance" asp-action="Index" class="btn btn-sm btn-outline-secondary">Посещаемость</a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-dark text-white py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-person-check-fill text-warning me-2"></i> Быстрый вход (Демо)</h5>
            </div>
            <div class="card-body">
                <p class="small text-muted">Система поддерживает роли с разграничением прав доступа (Задания 26, 27). Выберите роль для входа в 1 клик:</p>
                <div class="d-grid gap-2 mb-3">
                    <form asp-action="QuickLogin" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="role" value="admin" />
                        <button type="submit" class="btn btn-outline-danger w-100 text-start d-flex justify-content-between align-items-center">
                            <span><i class="bi bi-shield-shaded me-2"></i> Администратор</span>
                            <span class="badge bg-danger">admin / admin123</span>
                        </button>
                    </form>
                    <form asp-action="QuickLogin" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="role" value="teacher" />
                        <button type="submit" class="btn btn-outline-success w-100 text-start d-flex justify-content-between align-items-center">
                            <span><i class="bi bi-person-workspace me-2"></i> Преподаватель</span>
                            <span class="badge bg-success">teacher / teacher123</span>
                        </button>
                    </form>
                    <form asp-action="QuickLogin" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="role" value="student" />
                        <button type="submit" class="btn btn-outline-primary w-100 text-start d-flex justify-content-between align-items-center">
                            <span><i class="bi bi-backpack me-2"></i> Студент</span>
                            <span class="badge bg-primary">student / student123</span>
                        </button>
                    </form>
                </div>
                <div class="alert alert-secondary small mb-0 py-2">
                    <i class="bi bi-info-circle me-1"></i> Конфиденциальные данные пользователей (хэш и соль пароля) надежно скрыты через <code>private</code> (Задания 26-27).
                </div>
            </div>
            <div class="card-footer bg-light border-0">
                <a asp-action="Login" class="btn btn-sm btn-link text-decoration-none w-100 text-center">Обычная форма авторизации &rarr;</a>
            </div>
        </div>
    </div>
</div>
