@{
    ViewData["Title"] = "Доступ ограничен";
}

<div class="row justify-content-center text-center mt-5">
    <div class="col-md-6">
        <div class="card shadow-sm p-4">
            <i class="bi bi-shield-x text-danger display-1 mb-3"></i>
            <h3 class="fw-bold">Доступ ограничен</h3>
            <p class="text-muted">Для выполнения данного действия требуются дополнительные права доступа (например, роль Администратора).</p>
            <div class="mt-3">
                <a asp-action="Index" class="btn btn-primary me-2"><i class="bi bi-house"></i> На главную</a>
                <a asp-action="Login" class="btn btn-outline-secondary"><i class="bi bi-box-arrow-in-right"></i> Войти под другим аккаунтом</a>
            </div>
        </div>
    </div>
</div>
