@model CollegeManagement.Models.Teacher
@{
    ViewData["Title"] = "Профиль преподавателя: " + Model.GetFullName();
}

<div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom flex-wrap gap-2">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-person-workspace text-success me-2"></i> @Model.GetFullName()</h2>
        <p class="text-muted mb-0">Карточка преподавателя (Задания 9, 10, 18, 19, 23, 25)</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="UpdateExperience" asp-route-id="@Model.Id" class="btn btn-warning btn-sm fw-semibold">
            <i class="bi bi-award me-1"></i> Обновить стаж (UpdateExperience)
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Назад к списку
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-person-lines-fill text-success me-2"></i> Инкапсулированные данные преподавателя</h5>
            </div>
            <div class="card-body">
                <table class="table table-sm table-borderless mb-0">
                    <tbody>
                        <tr>
                            <td class="fw-semibold text-muted" style="width: 40%;">ID преподавателя:</td>
                            <td><span class="badge bg-secondary font-monospace">#@Model.Id</span></td>
                        </tr>
                        <tr>
                            <td class="fw-semibold text-muted">Имя (_name: protected):</td>
                            <td class="fw-bold">@Model.Name</td>
                        </tr>
                        <tr>
                            <td class="fw-semibold text-muted">Фамилия (_surname: protected):</td>
                            <td class="fw-bold">@Model.Surname</td>
                        </tr>
                        <tr>
                            <td class="fw-semibold text-muted">Возраст (_age: protected):</td>
                            <td>@Model.Age лет</td>
                        </tr>
                        <tr>
                            <td class="fw-semibold text-muted">Основной предмет (_subject: private):</td>
                            <td><span class="badge bg-info text-dark">@Model.Subject</span></td>
                        </tr>
                        <tr>
                            <td class="fw-semibold text-muted">Стаж (Задание 10: Experience):</td>
                            <td>
                                <span class="badge bg-success-subtle text-success border border-success fw-bold">
                                    @Model.Experience лет
                                </span>
                                <small class="text-muted d-block mt-1">(Изменяется ТОЛЬКО через <code>UpdateExperience()</code>)</small>
                            </td>
                        </tr>
                        <tr>
                            <td class="fw-semibold text-muted">GetFullName() (Задание 23):</td>
                            <td><span class="modifier-badge mod-prot-internal">protected internal</span> <code>@ViewBag.FullName</code></td>
                        </tr>
                        <tr>
                            <td class="fw-semibold text-muted">CalculateStatistics() (Задание 25):</td>
                            <td><span class="modifier-badge mod-priv-protected">private protected</span> <code>@ViewBag.InternalStatistics</code></td>
                        </tr>
                    </tbody>
                </table>

                <div class="alert alert-light border mt-3 mb-0 small">
                    <strong class="d-block mb-1"><i class="bi bi-terminal-fill me-1"></i> Результат GetTeacherInfo() (Задание 18, 19):</strong>
                    <code class="text-dark">@ViewBag.TeacherInfo</code>
                </div>
            </div>
        </div>
    </div>

    <!-- Закрепленные предметы -->
    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-book text-primary me-2"></i> Дисциплины преподавателя (Задание 14, 15)</h5>
            </div>
            <div class="card-body">
                <p class="small text-muted mb-3">Дисциплины, назначенные через метод <code>Subject.AssignTeacher()</code>:</p>
                <ul class="list-group list-group-flush">
                    @if (!((IEnumerable<CollegeManagement.Models.Subject>)ViewBag.Subjects).Any())
                    {
                        <li class="list-group-item text-muted small py-3">Закрепленных дисциплин пока нет.</li>
                    }
                    @foreach (var s in (IEnumerable<CollegeManagement.Models.Subject>)ViewBag.Subjects)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="mb-0 fw-semibold">@s.Name</h6>
                                <small class="text-muted">Академических часов: @s.Hours</small>
                            </div>
                            <span class="badge bg-primary">Дисциплина</span>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>
