@model CollegeManagement.Models.Student
@{
    ViewData["Title"] = "Изменение возраста: " + Model.GetFullName();
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card shadow-sm">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-clock-history text-warning me-2"></i> Изменение возраста студента (Задание 4)</h5>
            </div>
            <div class="card-body p-4">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger" role="alert">
                        @Html.ValidationSummary(false, "", new { @class = "mb-0" })
                    </div>
                }

                <div class="mb-3 p-3 bg-light rounded border">
                    <span class="text-muted small d-block">Студент:</span>
                    <strong class="fs-5">@Model.GetFullName()</strong>
                    <span class="badge bg-primary ms-2">@Model.Group</span>
                </div>

                <form asp-action="EditAge" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Новый возраст (Метод SetAge разрешает только от 15 до 70 лет)</label>
                        <input type="number" name="age" class="form-control form-control-lg text-center fw-bold" value="@Model.Age" required />
                        <div class="form-text small text-muted mt-2">
                            <i class="bi bi-info-circle me-1"></i> Поле <code>_age</code> является закрытым. Метод <code>SetAge(int age)</code> генерирует исключение <code>ArgumentOutOfRangeException</code>, если возраст выходит за пределы [15; 70].
                        </div>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Отмена</a>
                        <button type="submit" class="btn btn-warning fw-semibold">
                            <i class="bi bi-save me-1"></i> Применить SetAge()
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
