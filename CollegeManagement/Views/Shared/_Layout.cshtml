<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CollegeManagement</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100 bg-light">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm border-bottom border-primary border-3">
            <div class="container-fluid px-4">
                <a class="navbar-brand d-flex align-items-center fw-bold text-white" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-mortarboard-fill me-2 text-warning fs-4"></i>
                    <span>College<span class="text-primary">Management</span></span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent"
                        aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link text-white-50 hover-light" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i> Главная
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white-50" asp-controller="Student" asp-action="Index">
                                <i class="bi bi-people me-1"></i> Студенты
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white-50" asp-controller="Teacher" asp-action="Index">
                                <i class="bi bi-person-badge me-1"></i> Преподаватели
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white-50" asp-controller="Group" asp-action="Index">
                                <i class="bi bi-collection me-1"></i> Группы
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white-50" asp-controller="Grade" asp-action="Index">
                                <i class="bi bi-journal-check me-1"></i> Журнал оценок
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white-50" asp-controller="Attendance" asp-action="Index">
                                <i class="bi bi-calendar-check me-1"></i> Посещаемость
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-info fw-semibold" asp-controller="Home" asp-action="AccessModifiersGuide">
                                <i class="bi bi-shield-lock me-1"></i> Модификаторы доступа (Задания 1-30)
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-warning" asp-controller="Home" asp-action="Admin">
                                <i class="bi bi-gear-fill me-1"></i> Админ-панель
                            </a>
                        </li>
                    </ul>

                    <ul class="navbar-nav ms-auto align-items-center">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item dropdown me-2">
                                <a class="nav-link dropdown-toggle text-white d-flex align-items-center" href="#" role="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-person-circle fs-5 me-2 text-info"></i>
                                    <span>@User.Identity.Name</span>
                                    <span class="badge bg-primary ms-2">@User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow">
                                    <li><h6 class="dropdown-header">Текущий пользователь</h6></li>
                                    <li><span class="dropdown-item-text text-muted small"><i class="bi bi-shield-check me-1"></i> Роль: @User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</span></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item text-danger" asp-controller="Home" asp-action="Logout">
                                            <i class="bi bi-box-arrow-right me-1"></i> Выйти
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-outline-light btn-sm me-2" asp-controller="Home" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Вход
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="container-fluid px-4 py-4 flex-grow-1">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-check-circle-fill me-2 fs-5"></i>
                @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
                @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @RenderBody()
    </main>

    <footer class="footer mt-auto py-3 bg-white border-top shadow-sm">
        <div class="container-fluid px-4 d-flex flex-wrap justify-content-between align-items-center">
            <div class="text-muted small">
                <span>&copy; 2026 - CollegeManagement | Демонстрация модификаторов доступа C# (public, private, protected, internal, protected internal, private protected)</span>
            </div>
            <div class="d-flex align-items-center gap-3 small">
                <span class="badge bg-secondary">.NET 8.0 ASP.NET Core MVC</span>
                <span class="badge bg-success">SQLite Database</span>
                <a asp-controller="Home" asp-action="AccessModifiersGuide" class="text-decoration-none text-primary">Справка по заданиям</a>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
