@{
    ViewData["Title"] = "Выставление оценки";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-pencil-square text-warning me-2"></i> Выставление оценки (Задание 28)</h5>
            </div>
            <div class="card-body p-4">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger" role="alert">
                        @Html.ValidationSummary(false, "", new { @class = "mb-0" })
                    </div>
                }

                <form asp-action="Add" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Студент</label>
                        <select name="studentId" class="form-select" required>
                            <option value="">-- Выберите студента --</option>
                            @foreach (var s in (IEnumerable<CollegeManagement.Models.Student>)ViewBag.Students)
                            {
                                <option value="@s.Id">@s.GetFullName() (@s.Group)</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Учебный предмет</label>
                        <select name="subjectId" class="form-select" required>
                            <option value="">-- Выберите предмет --</option>
                            @foreach (var sub in (IEnumerable<CollegeManagement.Models.Subject>)ViewBag.Subjects)
                            {
                                <option value="@sub.Id">@sub.Name</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Оценка (Задание 28: строго от 2 до 5)</label>
                        <select name="value" class="form-select form-select-lg text-center fw-bold" required>
                            <option value="5" selected>5 - Отлично</option>
                            <option value="4">4 - Хорошо</option>
                            <option value="3">3 - Удовлетворительно</option>
                            <option value="2">2 - Неудовлетворительно</option>
                        </select>
                        <div class="form-text small text-muted">
                            <i class="bi bi-shield-check me-1"></i> Класс <code>GradeBook</code> и свойство <code>Grade.Value</code> отклоняют любые значения вне диапазона 2-5 (например, 1 или 6) через <code>ArgumentOutOfRangeException</code>.
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">Комментарий / тип работы</label>
                        <input type="text" name="comment" class="form-control" placeholder="Контрольная работа, лабораторная, ответ на паре" />
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary">Отмена</a>
                        <button type="submit" class="btn btn-warning text-dark fw-semibold">
                            <i class="bi bi-check-lg me-1"></i> Сохранить в журнал (AddGrade)
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
